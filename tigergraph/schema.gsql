CREATE GRAPH Transaction_Fraud ()


# Vertices
CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH STATS="TRUE"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, amount FLOAT, risk_score FLOAT, timestamp INT) WITH STATS="TRUE"
CREATE VERTEX Device (PRIMARY_ID id STRING, device_info STRING) WITH STATS="TRUE"
CREATE VERTEX IP (PRIMARY_ID id STRING) WITH STATS="TRUE"
CREATE VERTEX FraudCase (PRIMARY_ID id STRING, status STRING, risk_level STRING, decision STRING, sar_filed BOOL) WITH STATS="TRUE"

# Edges
CREATE DIRECTED EDGE OWNS_ACCOUNT (FROM Customer, TO Transaction)
CREATE DIRECTED EDGE ASSOCIATED_DEVICE (FROM Transaction, TO Device)
CREATE DIRECTED EDGE ORIGINATED_FROM_IP (FROM Transaction, TO IP)
CREATE DIRECTED EDGE LINKED_TO_CASE (FROM Transaction, TO FraudCase)
CREATE UNDIRECTED EDGE SHARED_DEVICE (FROM Customer, TO Device)

# Graph Compilation
RUN ADD GRAPH Transaction_Fraud (*)